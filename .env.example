# ═════════════════════════════════════════════════════════════
# Telegram Stars Bot — конфигурация.
# Скопируйте в .env (`cp .env.example .env`) и заполните значения.
# .env НИКОГДА не коммитится (см. .gitignore).
# ═════════════════════════════════════════════════════════════

# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (для /stats), напр. 12345,67890
ADMIN_IDS=


# ── Способы оплаты ───────────────────────────────────────────
# Настройте хотя бы один способ: WATA (карта/СБП) или GGP (проверенный TON).

# ── Оплата картой / СБП (WATA) ──
# Оставьте WATA_TOKEN пустым, чтобы отключить карточную оплату.
# Токен мерчанта из ЛК: https://merchant.wata.pro/
WATA_TOKEN=
WATA_BASE_URL=https://dg-api.wata.pro/api
WATA_PUBLIC_KEY_URL=https://api.wata.pro/api/h2h/public-key
# Наценка над minPrice, %. Итог клампится до +50% (диапазон WATA).
MARKUP_PERCENT=20
# Автоподтверждение выдачи звёзд (Review -> Paid) после оплаты.
AUTO_CONFIRM=true
# Максимум одновременных неоплаченных заказов на покупателя (лимит WATA).
MAX_ACTIVE_ORDERS=3

# ── Оплата криптой (TON через GreenGamePay) ──
# Заполните все три реквизита GGP, чтобы включить крипто-оплату; оставьте пустыми,
# чтобы её отключить.
#
# Бот подтверждает платёж только после сканирования TON: адрес назначения, точная
# сумма, memo и временное окно должны совпасть с заказом, а tx hash — быть уникальным.
# Лишь после этого вызывается GGP buyStars. get_ton_balance используется только для
# проверки готовности/достаточности баланса GGP и НЕ доказывает оплату заказа.
#
# Регистрация: GreenGamePay — https://xn--h1aahgceagbyl.xn--p1ai/ (пополнистим.рф).
# Логин/пароль и TON-адрес для пополнения — в личном кабинете.
GGP_USERNAME=
GGP_PASSWORD=
GGP_TON_ADDRESS=
GGP_BASE_URL=https://xn--h1aahgceagbyl.xn--p1ai
# Комментарий к платежу. Оставьте пустым — автоматически возьмётся GGP_USERNAME;
# заполните только если личный кабинет GGP выдал отдельное значение memo.
GGP_DEPOSIT_MEMO=
# Toncenter API v3 для проверки входящих транзакций. Ключ необязателен; без него
# используется публичный endpoint с ограничением 1 запрос в секунду.
TON_API_BASE=https://toncenter.com/api/v3
TON_API_KEY=
# Наценка для крипты, % (своя, обычно ниже карточной; клампа +50% тут нет).
CRYPTO_MARKUP_PERCENT=10
# Интервал сканирования TON (сек), видимое окно оплаты и короткое дополнительное
# окно сверки для задержки между отправкой кошельком, блоком и индексатором.
TON_POLL_INTERVAL=20
CRYPTO_PAYMENT_TTL_MIN=30
TON_RECONCILIATION_GRACE_MIN=10


# ── Прочее ───────────────────────────────────────────────────
# Тестовый режим: без реальных ссылок WATA — кнопка «Я оплатил (ТЕСТ)».
# Никогда не включайте его на production-базе.
TEST_MODE=false
# @username, по которому считается отображаемый курс «1 ⭐» (кэш ~1 час).
RATE_REFERENCE_USERNAME=hahahahgaha
LOG_LEVEL=INFO


# ── Партнёрская / реферальная программа ──────────────────────
# Вознаграждение рефереру с каждой оплаты приглашённого, %.
REFERRAL_PERCENT=5
# Комиссия оператора с наценки партнёрского бота, %.
PARTNER_COMMISSION_PERCENT=10
# Минимальная сумма вывода (₽) по способам.
WITHDRAW_MIN_SBP=500
WITHDRAW_MIN_CRYPTO=1000


# ── Инфраструктура ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/wata_bot
REDIS_URL=redis://redis:6379/0


# ── Webhook (бот работает только в режиме webhook) ───────────
# Публичный домен, на который смотрит ваш reverse proxy (напр. bot.example.com).
WEBHOOK_HOST=
# HTTP-порт webhook-сервера ВНУТРИ контейнера (за прокси, без TLS).
WEBHOOK_PORT=8080
# Путь для уведомлений WATA (укажите в ЛК WATA: https://<домен><WEBHOOK_PATH>).
WEBHOOK_PATH=/wata/webhook
# Необязательный доп. секрет WATA-вебхука (заголовок X-Webhook-Secret).
# RSA-подпись X-Signature проверяется обязательно независимо от этой настройки.
WEBHOOK_SECRET=
# Путь Telegram-вебхука. Секрет всегда автоматически выводится из BOT_TOKEN.
TELEGRAM_WEBHOOK_PATH=/tg/webhook


# ── Ссылки в разделе «Помощь» (пусто — кнопка скрыта) ────────
TERMS_URL=https://telegra.ph/POLZOVATELSKOE-SOGLASHENIE-PUBLICHNAYA-OFERTA-06-19
PRIVACY_URL=https://telegra.ph/POLITIKA-KONFIDENCIALNOSTI-I-OBRABOTKI-PERSONALNYH-DANNYH-06-19
SUPPORT_URL=https://t.me/nnstorecontactbot
